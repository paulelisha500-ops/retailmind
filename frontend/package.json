{
  "name": "retailmind",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --mode server",
    "build": "vite build && node scripts/prerender.mjs",
    "build:server": "vite build --mode server && node scripts/prerender.mjs --mode server",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "census": "node scripts/interactive-census.mjs",
    "lint": "eslint src tests scripts"
  },
  "dependencies": {
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/parser": "^8.0.6",
    "@babel/traverse": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "description": "Retail operations platform — forecasting, procurement, shelf alerts, register and customer app.",
  "overrides": {
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}

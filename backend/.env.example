APP_NAME="RetailMind API"
ENVIRONMENT=development

# Where the data lives. Unset, it is a local SQLite file (retailmind.db) and nothing else needs to be installed.
# For a shared, multi-user database point it at PostgreSQL instead:
# DATABASE_URL=postgresql+psycopg2://retailmind:retailmind@localhost:5432/retailmind

# Reserved: nothing in the API reads this yet
REDIS_URL=redis://localhost:6379/0

# Required: 32 or more random characters, e.g. `openssl rand -hex 32`. Placeholder values are rejected at start-up.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Web origins allowed to call the API. pydantic-settings reads lists as JSON:
ALLOWED_ORIGINS=["http://localhost:3002","http://localhost:4173","http://localhost:5173","http://localhost:3000"]

# Set to true only on a throwaway deployment: enables POST /workspace/reset, which wipes the data and re-seeds it.
ALLOW_WORKSPACE_RESET=false

# --- Supplier outreach: all optional. Leave unset and the "Notify supplier" button logs exactly what it would send,
# without dialing or emailing anyone. Fill a channel's settings in to send for real. ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@yourdomain.com
# SMTP_PASSWORD=an-app-password-not-your-real-password
# SMTP_FROM_EMAIL=you@yourdomain.com
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...

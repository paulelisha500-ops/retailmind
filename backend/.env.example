APP_NAME="RetailMind AI API"
ENVIRONMENT=development

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://retailmind:retailmind@localhost:5432/retailmind

# Redis connection string (live shelf-% / alert-count layer)
REDIS_URL=redis://localhost:6379/0

# Generate a real secret for this: `openssl rand -hex 32`
# Required: 32+ random characters (openssl rand -hex 32). Placeholder values are rejected at startup.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Comma-separated list is NOT supported by pydantic-settings list parsing by
# default — set this as a JSON array string, e.g.:
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Supplier outreach (Module 5/6) — all optional. Leave unset and the
# "Notify supplier" button logs exactly what it would send without dialing
# or emailing anyone. Fill these in to make it real: ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@yourdomain.com
# SMTP_PASSWORD=an-app-password-not-your-real-password
# SMTP_FROM_EMAIL=you@yourdomain.com
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_FROM_NUMBER=+1...
